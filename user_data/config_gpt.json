{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "version": 1,
  "dry_run": true,
  "dry_run_wallet": 1000,
  "strategy": "MTFTrendATRStrategy",
  "strategy_path": "user_data/strategies/",
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true,
      "options": {
        "adjustForTimeDifference": true
      }
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "options": {
        "adjustForTimeDifference": true
      }
    },
    "pair_whitelist": [],
    "pair_blacklist": [
      ".*(BEAR|BULL|UP|DOWN|3L|3S)"
    ]
  },
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "trading_mode": "spot",
  "timeframe": "15m",
  "startup_candle_count": 200,
  "max_open_trades": 5,
  "cancel_open_orders_on_exit": false,
  "minimal_roi": {
    "0": 0.05,
    "60": 0.03,
    "120": 0.015,
    "240": 0.0
  },
  "stoploss": -0.10,
  "trailing_stop": true,
  "trailing_stop_positive": 0.02,
  "trailing_stop_positive_offset": 0.03,
  "trailing_only_offset_is_reached": true,
  "use_exit_signal": true,
  "exit_profit_only": true,
  "exit_profit_offset": 0.01,
  "ignore_roi_if_entry_signal": false,
  "entry_pricing": {
    "price_side": "same",
    "price_last_balance": 0.0,
    "use_order_book": true,
    "order_book_top": 1,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "price_last_balance": 0.0,
    "use_order_book": true,
    "order_book_top": 1
  },
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "emergency_exit": "market",
    "force_exit": "market",
    "force_entry": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false,
    "stoploss_on_exchange_interval": 60,
    "stoploss_on_exchange_limit_ratio": 0.99
  },
  "order_time_in_force": {
    "entry": "GTC",
    "exit": "GTC"
  },
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 1,
    "unit": "minutes"
  },
  "pairlists": [
    {
      "method": "VolumePairList",
      "number_assets": 30,
      "sort_key": "quoteVolume",
      "min_value": 50,
      "refresh_period": 1800
    },
    {
      "method": "AgeFilter",
      "min_days_listed": 30
    },
    {
      "method": "PrecisionFilter"
    },
    {
      "method": "PriceFilter",
      "low_price_ratio": 0.01,
      "min_price": 0.00001
    },
    {
      "method": "SpreadFilter",
      "max_spread_ratio": 0.005
    }
  ],
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "api_server": {
    "enabled": false,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "change-me-to-a-random-string",
    "CORS_origins": [
      "*"
    ],
    "username": "freqtrader",
    "password": "SuperSecurePassword"
  },
  "bot_name": "freqtrade-mtf",
  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5,
    "heartbeat_interval": 60
  },
  "logging": {
    "level": "INFO",
    "logfile": false
  }
}