{
  "version": 1,
  "dry_run": true,
  "strategy": "MTFTrendATRStrategy",

  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true,
      "options": { "adjustForTimeDifference": true }
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "options": { "adjustForTimeDifference": true }
    }
  },

  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,

  "timeframe": "15m",
  "startup_candle_count": 200,
  "max_open_trades": 5,

  "entry_pricing": {
    "price_side": "same",
    "price_last_balance": 0.0,
    "use_order_book": true,
    "order_book_top": 1
  },

  "exit_pricing": {
    "price_side": "same",
    "price_last_balance": 0.0,
    "use_order_book": true,
    "order_book_top": 1
  },

  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },

  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 1,
    "unit": "minutes"
  },

  "pairlists": [
    {
      "method": "VolumePairList",
      "number_assets": 30,
      "sort_key": "quoteVolume",
      "period": 14,
      "min_value": 50
    }
  ],

  "pair_whitelist": [],
  "pair_blacklist": [".*(BEAR|BULL|UP|DOWN|3L|3S)"] ,

  "telegram": {
    "enabled": false
  },

  "api_server": {
    "enabled": false
  },

  "logging": {
    "level": "INFO",
    "logfile": false
  }
}
